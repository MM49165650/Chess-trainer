# Production settings for chess.asanfa.com. Copy this file to .env in the
# repository folder on the server, fill in APP_KEY and DB_PASSWORD as
# docs/deployment.md says, and never commit the result.

# Makes a plain `docker compose` in this folder use the production file.
COMPOSE_FILE=compose.production.yaml

APP_NAME="Asanfa Chess Trainer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chess.asanfa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Laravel's log goes to the container's output: `docker compose logs app`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=chess_training
DB_USERNAME=chess_training
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

INERTIA_SSR_ENABLED=false

# The gateway of the app's Docker network, fixed in compose.production.yaml.
# It is the only address whose forwarding headers are believed.
TRUSTED_PROXIES=172.30.12.1
