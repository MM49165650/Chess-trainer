# Asanfa Chess Trainer: proxies the whole site to the app container on
# 127.0.0.1:8012. Copied from solvefem.stpl with the port changed and the domain
# logs added. Kept in the repository as deploy/hestia/asanfa.stpl; see
# docs/deployment.md for how to install it.

server {
    listen      %ip%:%proxy_ssl_port% ssl;
    server_name %domain_idn% %alias_idn%;
    ssl_certificate     %ssl_pem%;
    ssl_certificate_key %ssl_key%;
    access_log  /var/log/%web_system%/domains/%domain%.log combined;
    access_log  /var/log/%web_system%/domains/%domain%.bytes bytes;
    error_log   /var/log/%web_system%/domains/%domain%.error.log error;

    location / {
        proxy_pass http://127.0.0.1:8012;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
