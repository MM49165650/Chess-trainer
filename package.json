{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "types": "vue-tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write --no-error-on-unmatched-pattern \"resources/**/*.{ts,vue,css}\" \"tools/**/*.ts\" \"*.{js,ts}\"",
        "format:check": "prettier --check --no-error-on-unmatched-pattern \"resources/**/*.{ts,vue,css}\" \"tools/**/*.ts\" \"*.{js,ts}\"",
        "test": "vitest run",
        "licences": "node tools/check/licences.ts",
        "silencers": "node tools/check/silencers.ts"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "chess.js": "^1.4.0",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.1.1",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.0.0",
        "vitest": "^5.0.3",
        "vue-tsc": "^2.2.4"
    }
}
